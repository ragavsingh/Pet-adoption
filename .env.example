# ==============================================================================
# PET ADOPTION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in the project root directory:
#      cp .env.example .env.local
# 2. Fill in your real Supabase Project credentials below.
# 3. Restart the Vite development server (Ctrl+C, then 'npm run dev') so Vite
#    loads the new environment variables into import.meta.env.
#
# SECURITY NOTE:
# - NEVER commit '.env' or '.env.local' to version control (protected by .gitignore).
# - NEVER prefix private server secrets (like service role keys) with 'VITE_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE SUPABASE CONFIGURATION (Public / Anon)
# ------------------------------------------------------------------------------
# Find in Supabase Dashboard -> Project Settings -> API:
#   - Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

#   - Project API Keys -> 'anon' / 'public' (or modern 'publishable' key):
#     (The application accepts either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY)
VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE TRANSACTIONAL EMAIL CONFIGURATION (Private - NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Provider API Key (e.g. your Resend key: your-resend-key-here)
RESEND_API_KEY=

# Verified sender identity (e.g. Pet Adoption <notifications@updates.petadoption.org>)
EMAIL_FROM=Pet Adoption <notifications@updates.petadoption.org>

# Reply-to address for adopter/provider inquiries
EMAIL_REPLY_TO=support@petadoption.org

# Base application URL for email action links (e.g. http://localhost:5173 or https://petadoption.org)
APP_URL=http://localhost:5173

# Email dispatch mode: 'development' (simulates/logs delivery to console) or 'production' (live sending)
EMAIL_MODE=development

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE DATABASE SERVICE ROLE (Private - strictly backend / Edge Functions)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> API -> Project API Keys -> 'service_role' (secret)
# NEVER expose this key in client-side code or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
